#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.10.2
GRADLE_DIR="$APP_HOME/.gradle/wrapper/dists/gradle-$GRADLE_VERSION"
GRADLE_ZIP="$APP_HOME/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ ! -x "$GRADLE_DIR/bin/gradle" ]; then
  mkdir -p "$(dirname "$GRADLE_ZIP")"
  if command -v curl >/dev/null 2>&1; then
    curl -L "$GRADLE_URL" -o "$GRADLE_ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$GRADLE_ZIP" "$GRADLE_URL"
  else
    echo "curl or wget is required to download Gradle." >&2
    exit 1
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$GRADLE_ZIP" -d "$(dirname "$GRADLE_ZIP")"
  elif command -v jar >/dev/null 2>&1; then
    (cd "$(dirname "$GRADLE_ZIP")" && jar xf "$GRADLE_ZIP")
  elif command -v powershell.exe >/dev/null 2>&1; then
    WIN_ZIP="$GRADLE_ZIP"
    WIN_DEST="$(dirname "$GRADLE_ZIP")"
    if command -v cygpath >/dev/null 2>&1; then
      WIN_ZIP=$(cygpath -w "$GRADLE_ZIP")
      WIN_DEST=$(cygpath -w "$WIN_DEST")
    elif command -v wslpath >/dev/null 2>&1; then
      WIN_ZIP=$(wslpath -w "$GRADLE_ZIP")
      WIN_DEST=$(wslpath -w "$WIN_DEST")
    elif printf '%s' "$GRADLE_ZIP" | grep -q '^/mnt/[a-zA-Z]/'; then
      DRIVE=$(printf '%s' "$GRADLE_ZIP" | cut -c6 | tr '[:lower:]' '[:upper:]')
      WIN_ZIP="$DRIVE:$(printf '%s' "$GRADLE_ZIP" | cut -c7- | sed 's#/#\\#g')"
      WIN_DEST="$DRIVE:$(printf '%s' "$WIN_DEST" | cut -c7- | sed 's#/#\\#g')"
    fi
    powershell.exe -NoProfile -Command "Expand-Archive -LiteralPath '$WIN_ZIP' -DestinationPath '$WIN_DEST' -Force"
  else
    echo "unzip or jar is required to extract Gradle." >&2
    exit 1
  fi
fi

exec "$GRADLE_DIR/bin/gradle" "$@"
